# =============================================================
# VeristasId — Environment Variables Template
# =============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values    (see comments below each variable)
# 3. NEVER commit .env to version control
#    (.env is already listed in .gitignore)
# =============================================================

# ─────────────────────────────────────────────────────────────
# DATABASE  (PostgreSQL)
# ─────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/btp_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# ─────────────────────────────────────────────────────────────
# ETHEREUM / WEB3
# ─────────────────────────────────────────────────────────────

# RPC endpoint for the Ethereum node.
# Local dev  → Ganache default
# Testnet    → https://sepolia.infura.io/v3/<YOUR_INFURA_KEY>
# Mainnet    → https://mainnet.infura.io/v3/<YOUR_INFURA_KEY>
BLOCKCHAIN_NODE_URL=http://127.0.0.1:8545

# Raw 32-byte secp256k1 private key in hex (no 0x prefix).
#
# Local dev (Ganache default account #0):
#   ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#   Funded with 100 ETH by Ganache — safe for local use only.
#
# Testnet/Production:
#   Export from MetaMask → Account Details → Export Private Key
#   Fund the address with test ETH from a faucet (e.g. sepoliafaucet.com)
#
# ⚠️  NEVER use a wallet that holds real ETH on mainnet for this key.
BLOCKCHAIN_WALLET_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Address of the deployed VeristasAudit smart contract.
#
# First run  → Set to NONE. The app will deploy the contract automatically
#              and print the address to logs:
#              "✅ [BLOCKCHAIN] Contract deployed at: 0x..."
#
# After deploy → Copy the logged address here and restart.
#              The app will then load the existing contract instead of redeploying.
VERISTAS_CONTRACT_ADDRESS=NONE

# ─────────────────────────────────────────────────────────────
# JWT / IDENTITY
# ─────────────────────────────────────────────────────────────

# Base64-encoded 256-bit HMAC secret for signing staff JWTs.
# Generate a new one:  openssl rand -base64 32
JWT_SECRET_KEY=VmVyaXN0YXNJZE1lZGljYWxJZGVudGl0eVN5c3RlbTIwMjZTZWN1cmVLZXk=

# DID issuer identity (hex-encoded PKCS8 EC private key)
# This is the hospital/issuer key used to sign Verifiable Credentials.
# Loaded from wallet_private.key on disk — update if key rotated.
ISSUER_DID=did:ethr:0x9e296e20cd32005acb29e70578e3a0908843156b

# ─────────────────────────────────────────────────────────────
# HOSPITAL IDENTITY (Multi-Institution)
# ─────────────────────────────────────────────────────────────
# Unique decentralised identifier for THIS hospital deployment.
#
# Multiple hospitals can share the SAME VERISTAS_CONTRACT_ADDRESS
# on a public testnet — each hospital instance uses its own
# HOSPITAL_DID so every on-chain audit record is traceable back
# to the institution that made the access decision.
#
# Examples:
#   did:veristas:hospital:AIIMS_Delhi
#   did:veristas:hospital:Apollo_Mumbai
#   did:veristas:hospital:Fortis_Chennai
#
# Each hospital also needs its OWN BLOCKCHAIN_WALLET_PRIVATE_KEY
# (its own funded Ethereum wallet) to sign transactions.
HOSPITAL_DID=did:veristas:hospital:MyHospital
